{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSE pair ledger",
  "type": "object",
  "required": [
    "schema_version",
    "study_id",
    "required_modalities",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.6.1"
    },
    "study_id": {
      "type": "string"
    },
    "required_modalities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "content",
          "geometry",
          "styles",
          "visual",
          "responsive",
          "interaction",
          "font_identity",
          "asset_identity"
        ]
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entry_id",
          "viewport_id",
          "theme",
          "state_id",
          "modality",
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "MEASURED",
              "NOT_TESTED",
              "NOT_COMPARABLE",
              "BLOCKED"
            ]
          },
          "result": {
            "enum": [
              "PASS",
              "PARTIAL",
              "FAIL",
              "NOT_TESTED"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
