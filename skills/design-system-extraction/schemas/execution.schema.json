{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSE execution manifest",
  "type": "object",
  "required": [
    "schema_version",
    "study_id",
    "task_type",
    "artifact_mode",
    "target",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": "1.6.1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "enum": [
        "analysis",
        "reconstruction",
        "comparison",
        "audit"
      ]
    },
    "artifact_mode": {
      "enum": [
        "snapshot",
        "standalone_mockup",
        "functional_implementation",
        "not_applicable"
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "requested_url",
        "final_url"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "pages",
        "viewports",
        "themes",
        "states",
        "required_checks"
      ],
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1
        },
        "viewports": {
          "type": "array",
          "minItems": 1
        },
        "themes": {
          "type": "array",
          "minItems": 1
        },
        "states": {
          "type": "array",
          "minItems": 1
        },
        "required_checks": {
          "type": "array"
        }
      }
    }
  },
  "additionalProperties": true
}
