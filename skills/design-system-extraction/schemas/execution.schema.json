{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design System Extraction execution contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "task_type",
    "artifact_mode",
    "target",
    "scope",
    "capabilities",
    "constraints",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.5.0"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "enum": [
        "analysis",
        "reconstruction",
        "comparison",
        "audit"
      ]
    },
    "artifact_mode": {
      "enum": [
        "snapshot",
        "standalone_mockup",
        "functional_implementation",
        "not_applicable"
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "requested_url",
        "final_url"
      ],
      "properties": {
        "requested_url": {
          "type": "string",
          "minLength": 1
        },
        "final_url": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "required": [
        "pages",
        "viewports",
        "themes",
        "states",
        "required_checks"
      ],
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "width",
              "height"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "themes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "available",
          "partial",
          "unavailable",
          "not_checked"
        ]
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  }
}