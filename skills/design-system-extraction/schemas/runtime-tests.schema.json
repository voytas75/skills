{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSE runtime tests",
  "type": "object",
  "required": [
    "interactions",
    "resolved_font_status",
    "font_runs"
  ],
  "properties": {
    "interactions": {
      "type": "array"
    },
    "resolved_font_status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_TESTED"
      ]
    },
    "font_runs": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
