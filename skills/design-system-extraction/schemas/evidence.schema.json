{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design System Extraction evidence package",
  "type": "object",
  "required": [
    "schema_version",
    "study_id",
    "task_type",
    "artifact_mode",
    "created_at",
    "target",
    "samples",
    "evidence_registry",
    "findings",
    "limitations",
    "outcomes",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "1.5.0"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "enum": [
        "analysis",
        "reconstruction",
        "comparison",
        "audit"
      ]
    },
    "artifact_mode": {
      "enum": [
        "snapshot",
        "standalone_mockup",
        "functional_implementation",
        "not_applicable"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object"
    },
    "samples": {
      "type": "array"
    },
    "evidence_registry": {
      "type": "array"
    },
    "findings": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "outcomes": {
      "type": "object"
    },
    "results": {
      "type": "object"
    },
    "dependencies": {
      "type": "array"
    },
    "comparison_file": {
      "type": "string"
    }
  },
  "additionalProperties": true
}