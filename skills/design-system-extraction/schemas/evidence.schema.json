{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSE evidence package",
  "type": "object",
  "required": [
    "schema_version",
    "study_id",
    "task_type",
    "artifact_mode",
    "samples",
    "evidence_registry",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "1.6.1"
    },
    "study_id": {
      "type": "string"
    },
    "samples": {
      "type": "array"
    },
    "evidence_registry": {
      "type": "array"
    },
    "results": {
      "type": "object"
    },
    "fidelity": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
