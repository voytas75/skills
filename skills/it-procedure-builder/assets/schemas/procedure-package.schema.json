{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProcedurePackage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "title", "sourceRequestSummary", "sections", "claims"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "title": { "type": "string", "minLength": 5, "maxLength": 200 },
    "sourceRequestSummary": { "type": "string", "minLength": 20 },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executiveSummary", "scope", "assumptions", "dependencies", "rolesAndResponsibilities", "phasedImplementationPlan", "detailedExecutionSteps", "deliverables", "riskRegister", "validationPlan", "rollbackPlan", "successMetrics", "mermaidDiagram", "openQuestions"],
      "properties": {
        "executiveSummary": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "assumptions": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "string", "minLength": 1 },
        "rolesAndResponsibilities": { "type": "string", "minLength": 1 },
        "phasedImplementationPlan": { "type": "string", "minLength": 1 },
        "detailedExecutionSteps": { "type": "string", "minLength": 1 },
        "deliverables": { "type": "string", "minLength": 1 },
        "riskRegister": { "type": "string", "minLength": 1 },
        "validationPlan": { "type": "string", "minLength": 1 },
        "rollbackPlan": { "type": "string", "minLength": 1 },
        "successMetrics": { "type": "string", "minLength": 1 },
        "mermaidDiagram": { "type": "string", "minLength": 1 },
        "openQuestions": { "type": "string", "minLength": 1 }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "status", "evidenceIds"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "status": { "enum": ["confirmed", "assumption", "unknown"] },
          "evidenceIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
