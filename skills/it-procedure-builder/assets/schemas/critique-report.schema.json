{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CritiqueReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "scores", "missingRequiredSections", "criticalIssues", "requiredFixes", "decision"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeness", "executability", "safety", "evidenceAlignment", "validationAndRollback"],
      "properties": {
        "completeness": { "type": "number", "minimum": 0, "maximum": 5 },
        "executability": { "type": "number", "minimum": 0, "maximum": 5 },
        "safety": { "type": "number", "minimum": 0, "maximum": 5 },
        "evidenceAlignment": { "type": "number", "minimum": 0, "maximum": 5 },
        "validationAndRollback": { "type": "number", "minimum": 0, "maximum": 5 }
      }
    },
    "missingRequiredSections": { "type": "array", "items": { "type": "string" } },
    "criticalIssues": { "type": "array", "items": { "type": "string" } },
    "requiredFixes": { "type": "array", "items": { "type": "string" } },
    "decision": { "enum": ["accepted", "revision_required", "needs_human_input"] }
  }
}
