{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProcedureRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "goal", "evidence", "constraints"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "goal": { "type": "string", "minLength": 20, "maxLength": 4000 },
    "environment": { "type": "object", "additionalProperties": true },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "locator", "trust"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "kind": { "enum": ["user-provided", "workspace-note", "official-doc", "unverified"] },
          "locator": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "trust": { "enum": ["confirmed", "contextual", "unverified"] }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noProductionChanges"],
      "properties": {
        "noProductionChanges": { "type": "boolean" },
        "outputLanguage": { "enum": ["en", "pl"] }
      }
    }
  }
}
